{erl_opts, [debug_info]}.

{deps, [
    {lfe, "2.2.0"},
    {msgpack, "0.8.1"}
]}.

{plugins, [
    {rebar3_lfe, "0.4.11"}
]}.

{provider_hooks, [
    {pre, [{compile, {lfe, compile}}]}
]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.5.0"},
            {ltest, "0.13.11"}
        ]},
        {plugins, [
            {rebar3_proper, "0.12.1"}
        ]},
        {eunit_opts, [verbose]},
        {erl_opts, [{src_dirs, ["src", "test"]}]}
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]}
]}.
